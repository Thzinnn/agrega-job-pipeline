{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JobFormatterOutput",
  "type": "object",
  "required": [
    "jobs"
  ],
  "properties": {
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id_vaga",
          "titulo",
          "empresa",
          "local",
          "descricao",
          "data_coleta"
        ],
        "properties": {
          "id_vaga": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "description": "Hash único da vaga (SHA256(titulo+empresa+local+link)[:12] ou similar)"
          },
          "titulo": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "empresa": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "local": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "description": "Ex: 'São Paulo, SP' ou 'Remoto'"
          },
          "salario": {
            "type": [
              "string",
              "null"
            ],
            "description": "Texto original se existir (ex: 'R$ 2.500'), nunca calculado. Extrair ativamente da descrição se input tiver null."
          },
          "tipo_vaga": {
            "type": [
              "string",
              "null"
            ],
            "description": "Ex: 'CLT', 'PJ', 'Estágio', 'Efetivo CLT'"
          },
          "turno_horario": {
            "type": [
              "string",
              "null"
            ],
            "description": "Ex: 'Integral', 'Meio período', 'De segunda à sexta-feira'"
          },
          "beneficios": {
            "type": [
              "string",
              "null"
            ],
            "description": "Lista textual de benefícios encontrados (ex: 'Vale-transporte, Vale-refeição, Gympass'). Servidor converte para booleanas."
          },
          "descricao": {
            "type": "string",
            "minLength": 10,
            "description": "Texto COMPLETO da vaga. NUNCA resumir ou abreviar. Fidelidade vital para classificação automática do servidor."
          },
          "link": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "Link original para candidatura"
          },
          "data_coleta": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$",
            "description": "Formato 'YYYY-MM-DD HH:mm'. Usar now() se ausente."
          }
        },
        "additionalProperties": false
      }
    },
    "campos_inferidos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista dos campos que o agente preencheu lendo a descrição (não vieram no input). Para auditoria."
    }
  },
  "additionalProperties": false
}